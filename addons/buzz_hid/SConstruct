#!/usr/bin/env python
import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# SCons compiles hidapi directly from source. Fetch the source first:
#   git clone --depth 1 https://github.com/libusb/hidapi.git third_party/hidapi
#
# This project compiles the macOS backend source file (mac/hid.c) directly
# into buzz_hid. As a result, buzz_hid has no external runtime dependency
# beyond IOKit and CoreFoundation, both part of macOS. SCons also compiles
# this source for both architectures under arch=universal, with no
# separate build step.
env.Append(CPPPATH=["third_party/hidapi/hidapi"])
sources.append("third_party/hidapi/mac/hid.c")
env.Append(LINKFLAGS=["-framework", "IOKit", "-framework", "CoreFoundation"])

if env["platform"] == "macos":
	library = env.SharedLibrary(
		"bin/libbuzz_hid.{}.{}.dylib".format(env["platform"], env["target"]),
		source=sources,
	)
else:
	# This extension targets macOS only. It works around an SDL3 joystick
	# detection gap on that platform (see buzz_hid.h). Linux and Windows
	# already read the Buzz controller correctly through Godot's normal
	# Input API.
	print("buzz_hid only builds for platform=macos.")
	Exit(1)

Default(library)
